rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         request.auth.token.email == "litughosal@gmail.com");
    }

    // Validation functions
    function isValidProject(data) {
      return data.title is string && data.title.size() > 0 &&
             data.description is string &&
             data.order is number;
    }

    function isValidAchievement(data) {
      return data.title is string && data.title.size() > 0 &&
             data.description is string &&
             data.date is string &&
             data.type in ['hackathon', 'certification', 'internship'];
    }

    function isValidCertificate(data) {
      return data.title is string && data.title.size() > 0 &&
             data.imageUrl is string &&
             (!('date' in data) || data.date is string);
    }

    function isValidProfile(data) {
      return data.name is string && data.tagline is string;
    }

    // Rules
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProject(request.resource.data);
      allow delete: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidAchievement(request.resource.data);
      allow delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCertificate(request.resource.data);
      allow delete: if isAdmin();
    }

    match /profile/{profileId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProfile(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAdmin();
    }
  }
}
