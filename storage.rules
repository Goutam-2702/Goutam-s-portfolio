rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read access to all files
      allow read: if true;
      
      // Allow write access only to the admin
      allow write: if request.auth != null && (request.auth.token.email == "litughosal@gmail.com" || request.auth.uid == "4X2Xqho182VFdrVakVkqkyU8Pmc2");
    }
  }
}
